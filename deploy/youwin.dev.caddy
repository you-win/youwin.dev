# /etc/caddy/conf.d/youwin.dev.caddy
#
# Picked up by the `import /etc/caddy/conf.d/*.caddy` at the end of the main
# Caddyfile, the same way the static sites on this box are.
#
# TLS is Cloudflare DNS-01, matching the house style in
# grindshell/server-configs/static/Caddyfile — which needs a Caddy binary built
# with github.com/caddy-dns/cloudflare. The package from the Cloudsmith repo
# does NOT have it, and `caddy validate` fails outright with
# "module not registered: dns.providers.cloudflare" until it does. See
# deploy/README.md step 5.

# The public archive. No JS, no cookies, no API — so the whole surface is
# edge-cacheable and the CSP can forbid script outright.
youwin.dev, www.youwin.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	encode zstd gzip

	# The one stylesheet, content-hashed by Vite. Served off disk so the app
	# process never touches CSS bytes. The binary also mounts a ServeDir at
	# /assets, but this block matches first and therefore always wins; that
	# fallback exists for `cargo run` in dev.
	handle /assets/* {
		root * /srv/sites/youwin.dev/current/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# A named matcher, not `handle /favicon.ico /favicon-32x32.png …`.
	# Every directive takes at most ONE matcher token, so a list of paths
	# has to be bound to a matcher first — otherwise `caddy validate` fails
	# with "wrong argument count" and the whole config is rejected, every
	# site on the box included.
	@root_files path /favicon.ico /favicon-32x32.png /favicon-16x16.png /robots.txt
	handle @root_files {
		root * /srv/sites/youwin.dev/current/public
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# /random redirects to a different post on every request, so it is the
	# one path on this site that must NOT be cached. The catch-all below
	# stamps every proxied response with s-maxage=300, and `header` replaces
	# rather than defers — so the origin's own `no-store` would be
	# overwritten and the "random" link would return one fixed post for five
	# minutes at every edge. Handling it separately is what preserves it.
	#
	# Caddy sorts sibling handle blocks by path specificity, so this beats
	# the bare `handle` regardless of order. Exact path, no wildcard.
	handle /random {
		reverse_proxy 127.0.0.1:8080
	}

	# Everything else is server-rendered HTML. max-age is for the browser,
	# s-maxage for Cloudflare — which ALSO needs a cache rule in the
	# dashboard, since CF does not cache HTML by default. Without that rule
	# this header is inert and every request reaches the origin.
	#
	# The cost is that an edit or delete takes up to five minutes to appear.
	# See DESIGN.md for the purge-on-write alternative.
	handle {
		reverse_proxy 127.0.0.1:8080
		header Cache-Control "public, max-age=60, s-maxage=300"
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The strongest policy on the box, and honest: this site ships
		# zero JavaScript, so 'none' costs nothing to assert.
		#
		# form-action is 'self' rather than 'none' as of M5: the header
		# carries a GET search form. 'none' blocks the submission
		# outright, and `form-action` does NOT fall back to default-src,
		# so this is the only line that governs it.
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	log {
		output file /var/log/caddy/youwin.dev.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# The authoring app. The session cookie lives here and ONLY here — its __Host-
# prefix binds it to this exact host, so youwin.dev can never receive it.
write.youwin.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	encode zstd gzip

	# JSON API and the authenticated /preview route (M3). Listed before the
	# SPA fallback so they win.
	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /preview/* {
		reverse_proxy 127.0.0.1:8081
	}

	# /preview renders through the PUBLIC templates, so it links the public
	# site's stylesheet by its root-absolute path — which resolves against
	# THIS host. Serve that one file from the public root; without this the
	# preview is unstyled, which is precisely the thing it exists to show.
	# Caddy sorts sibling handle blocks by path specificity, not by the order
	# they appear in, so `/assets/public-*` beats `/assets/*` for the preview
	# stylesheet no matter how this file is arranged. Verified against
	# `caddy adapt`. Safe either way: Vite's hashed names cannot collide across
	# the two builds.
	handle /assets/public-* {
		root * /srv/sites/youwin.dev/current/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# Content-hashed SPA build output.
	handle /assets/* {
		root * /srv/sites/youwin.dev/current/write
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# PWA plumbing: on disk, but MUST revalidate. A cached sw.js pins an old
	# build on every installed device until it expires. Named matcher for the
	# same reason as @root_files above.
	@pwa path /sw.js /manifest.webmanifest /icons/*
	handle @pwa {
		root * /srv/sites/youwin.dev/current/write
		header Cache-Control "no-cache"
		file_server
	}

	# Client-routed SPA: serve the file if it exists, else the shell.
	handle {
		root * /srv/sites/youwin.dev/current/write
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}

	# Nothing here is ever cached at the edge — it is all authenticated.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# DENY, not SAMEORIGIN: nothing should ever frame the composer.
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	log {
		output file /var/log/caddy/write.youwin.dev.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
