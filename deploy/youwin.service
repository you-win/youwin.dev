# /etc/systemd/system/youwin.service
#
# One unit for both listeners: 8080 (public) and 8081 (authoring). The process
# binds loopback only — Caddy is the sole possible peer, which is what makes
# trusting CF-Connecting-IP / X-Forwarded-For for rate limiting sound.
#
# Everything below points through /srv/sites/youwin.dev/current, a symlink that
# `activate-youwin` flips between release directories. systemd resolves
# ExecStart at start time, so a restart is what picks up a new release — which
# is exactly the atomicity wanted: the binary and the assets it serves change
# together or not at all.

[Unit]
Description=youwin.dev microblog
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=youwin
Group=youwin
WorkingDirectory=/srv/sites/youwin.dev
ExecStart=/srv/sites/youwin.dev/current/bin/youwin-server

Environment=YOUWIN_DB=/var/lib/youwin/youwin.db
Environment=YOUWIN_PUBLIC_DIST=/srv/sites/youwin.dev/current/public
Environment=YOUWIN_PUBLIC_BIND=127.0.0.1:8080
Environment=YOUWIN_WRITE_BIND=127.0.0.1:8081
Environment=YOUWIN_PUBLIC_ORIGIN=https://youwin.dev
Environment=YOUWIN_WRITE_ORIGIN=https://write.youwin.dev
Environment=YOUWIN_COOKIE_SECURE=true
Environment=RUST_LOG=youwin_server=info,tower_http=warn

# Optional: invalidate Cloudflare's cache after every write, so an edit appears
# immediately instead of within s-maxage. Leave both unset to run on the TTL
# alone, which is a supported configuration and the documented default.
#
# The token belongs in secrets.env below, not here, and needs the Cache Purge
# permission ONLY. It must not be the DNS-01 token Caddy uses: that one is
# scoped to DNS edits, and widening it to save provisioning a second token
# trades a real boundary for a small convenience.
#Environment=YOUWIN_CF_ZONE_ID=...

# Holds YOUWIN_PASSWORD_HASH, and YOUWIN_CF_PURGE_TOKEN if purging is on.
# Mode 0600, owned by root, NOT in the repo.
# Generate with: youwin-server hash-password > /etc/youwin/secrets.env
EnvironmentFile=/etc/youwin/secrets.env

Restart=on-failure
RestartSec=2

# SIGTERM is handled: both listeners drain and the pools close, so SQLite
# checkpoints the WAL instead of leaving a hot journal behind.
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening. The process needs exactly one writable path and two loopback
# sockets; everything else is off.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/youwin
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
